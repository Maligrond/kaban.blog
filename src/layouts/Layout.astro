---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PageFind from "@components/PageFind.astro";
import AuthorMode from "@components/AuthorMode.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  disableTransitions?: boolean;
  image?: string;
};

const { title, description, image, disableTransitions = false } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <Head title={`${title} | ${SITE.TITLE}`} description={description} image={image} disableTransitions={disableTransitions} />
  </head>
  <body>
    <a class="skip-to-content" href="#main-content">К содержимому</a>
    <Header />
    <main id="main-content" tabindex="-1" data-pagefind-ignore={Astro.url.pathname === "/author/" ? "all" : undefined}>
      <slot />
    </main>
    <Footer />
    <PageFind />
    <AuthorMode />
  </body>
</html>
