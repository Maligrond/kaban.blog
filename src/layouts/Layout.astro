---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PhotoViewer from "@components/PhotoViewer.astro";
import AuthorMode from "@components/AuthorMode.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  disableTransitions?: boolean;
  image?: string;
  searchDescription?: string;
};

const { title, description, image, searchDescription = description, disableTransitions = false } = Astro.props;
const pathname = Astro.url.pathname;
const searchType = /^\/blog\/[^/]+\//.test(pathname) ? "Запись"
  : pathname.startsWith("/countries/") ? "Город"
  : /^\/world\/[^/]+\//.test(pathname) ? "Страна" : "Раздел";
---

<!doctype html>
<html lang="ru">
  <head>
    <Head title={`${title} | ${SITE.TITLE}`} description={description} image={image} disableTransitions={disableTransitions} />
  </head>
  <body>
    <a class="skip-to-content" href="#main-content">К содержимому</a>
    <Header />
    <main id="main-content" tabindex="-1" data-pagefind-ignore={Astro.url.pathname === "/author/" ? "all" : undefined}>
      <span hidden data-pagefind-meta="description">{searchDescription}</span>
      <span hidden data-pagefind-meta="Тип">{searchType}</span>
      <slot />
    </main>
    <PhotoViewer />
    <Footer />
    <AuthorMode />
  </body>
</html>
