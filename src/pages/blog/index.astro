---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import NotePreview from "@components/NotePreview.astro";
import { BLOG } from "@consts";
const data = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = data.reduce((acc: Record<string, CollectionEntry<"blog">[]>, post) => {
  const year = post.data.date.getUTCFullYear().toString();
  (acc[year] ||= []).push(post);
  return acc;
}, {});
const years = Object.keys(posts).sort((a, b) => Number(b) - Number(a));
const tags = [...new Set(data.flatMap(post => post.data.tags || []))].sort((a, b) => a.localeCompare(b, "ru"));
---
<Layout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="journal-page" data-pagefind-ignore>
      <div class="journal-page-heading">
        <p class="eyebrow">Личный блог</p>
        <h1>Блог<span class="accent-dot">.</span></h1>
        <p class="journal-page-intro">Мысли, находки и истории из жизни.</p>
      </div>
      <div class="journal-columns">
        <div>
          {years.map(year => <section aria-label={`Записи за ${year} год`} class="archive-year">
            <div class="section-caption"><h2><a href={`/archive/${year}/`}>{year}</a></h2><span>Записей: {posts[year].length}</span></div>
            {posts[year].map(post => <NotePreview post={post} flow />)}
          </section>)}
          {data.length === 0 && <p class="journal-page-intro">Первая запись появится здесь скоро.</p>}
        </div>
        <aside class="journal-aside tag-aside">
          <h2 class="eyebrow">По темам</h2>
          <div class="topic-links">
            {tags.map(tag => <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}<span>{data.filter(post => post.data.tags?.includes(tag)).length}</span></a>)}
          </div>
          <a class="aside-action" href="/tags/">Все темы ↗</a>
          <a class="aside-action" href="/archive/">Архив по годам ↗</a>
          <a class="aside-action" href="/rss.xml">Подписаться по RSS ↗</a>
        </aside>
      </div>
    </div>
  </Container>
</Layout>
