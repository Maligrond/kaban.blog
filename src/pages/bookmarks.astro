---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { getCollection } from "astro:content";
const bookmarks = (await getCollection("bookmarkItems")).map(entry => entry.data).sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<Layout title="Закладки" description="Интересные ссылки, которые я сохранил">
  <Container>
    <div class="journal-page-heading">
      <a href="/about/" class="back-to-notes">← Обо мне</a>
      <h1>Закладки<span class="accent-dot">.</span></h1>
      <p class="journal-page-intro shelf-intro">Статьи, видео, эссе и другие материалы, которые я сохранил на память.</p>
    </div>
    <div class="journal-columns">
      <section aria-label="Сохранённые ссылки">
        <div class="section-caption"><span>Сначала новые</span><span>Всего: {bookmarks.length}</span></div>
        <ul class="bookmark-list">
          {bookmarks.map(bookmark => <li>
            <h2><a href={bookmark.url} target="_blank" rel="noopener noreferrer">{bookmark.title}<span class="bookmark-arrow" aria-hidden="true"> ↗</span></a></h2>
            {bookmark.description && <p class="bookmark-description">{bookmark.description}</p>}
            <div class="note-meta"><span class="bookmark-domain">{new URL(bookmark.url).hostname.replace(/^www\./, "")}</span><FormattedDate date={bookmark.date} /></div>
            {bookmark.tags.length > 0 && <ul class="bookmark-tags" aria-label="Темы">{bookmark.tags.map(tag => <li>{tag}</li>)}</ul>}
          </li>)}
        </ul>
        {bookmarks.length === 0 && <p class="journal-page-intro">Здесь пока нет ссылок.</p>}
      </section>
      <aside class="journal-aside shelf-aside">
        <h2 class="eyebrow">Ещё почитать</h2>
        <a href="/blog/">Блог ↗</a>
        <a href="/about/books/">Книги ↗</a>
      </aside>
    </div>
  </Container>
</Layout>
