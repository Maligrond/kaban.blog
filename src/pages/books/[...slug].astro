---
import { shelfStatusLabel } from "../../scripts/author-entries.js";
import Review from "@layouts/Review.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
export async function getStaticPaths() {
  return (await getCollection("books")).filter(entry => !entry.data.draft).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<"books">; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Review authorPath={`src/content/books/${entry.id}.md`}
  title={entry.data.title}
  description={`Мои впечатления: ${entry.data.title}`}
  subtitle={entry.data.author}
  date={entry.data.date}
  rating={entry.data.rating}
  status={shelfStatusLabel("books",entry.data.status)}
  backHref="/about/books/"
  backLabel="Все книги"
  url={entry.data.url}
  sourceLabel="Источник"
>
  <Content />
</Review>
