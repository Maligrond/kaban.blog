---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
const posts = await getCollection("blog", ({ data }) => !data.draft);
const tags = [...new Set(posts.flatMap(post => post.data.tags || []))].sort((a, b) => a.localeCompare(b, "ru"));
---
<Layout title="Темы" description="Все темы и теги личного блога.">
  <Container>
    <div class="journal-page" data-pagefind-ignore>
      <div class="journal-page-heading">
        <a class="back-to-notes" href="/blog/">← Все записи</a>
        <h1>Темы<span class="accent-dot">.</span></h1>
        <p class="journal-page-intro">Несколько способов найти интересное.</p>
      </div>
      <div class="topic-directory">
        {tags.map(tag => <a href={`/tags/${encodeURIComponent(tag)}/`}><span>{tag}</span><span class="topic-count">{posts.filter(post => post.data.tags?.includes(tag)).length}<span aria-hidden="true"> ↗</span></span></a>)}
      </div>
    </div>
  </Container>
</Layout>
