---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import NotePreview from "@components/NotePreview.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  // Get unique tags
  const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))];

  // Create paths for each tag
  return tags.map((tag) => ({
    params: { id: tag },
    props: {
      posts: posts.filter((post) => post.data.tags?.includes(tag)),
    },
  }));
}

const { id } = Astro.params;
const { posts } = Astro.props;

// Sort posts by date, most recent first
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
---

<Layout title={`Тег: ${id}`} description={`Записи с тегом «${id}»`}>
  <Container>
    <div class="journal-page topic-page" data-pagefind-ignore>
      <div class="journal-page-heading">
        <a class="back-to-notes" href="/tags/">← Все темы</a>
        <h1>{id}<span class="accent-dot">.</span></h1>
        <p class="journal-page-intro">Записи по теме</p>
      </div>
      <div class="topic-feed">
        {sortedPosts.map(post => <NotePreview post={post} />)}
      </div>
    </div>
  </Container>
</Layout>
