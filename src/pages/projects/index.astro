---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { PROJECTS } from "@consts";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="journal-page-heading">
      <a href="/about/" class="back-to-notes">← Обо мне</a>
      <h1>Проекты<span class="accent-dot">.</span></h1>
      <p class="journal-page-intro">Мои проекты и эксперименты.</p>
    </div>
    {projects.length === 0 && <p class="journal-page-intro">Проекты появятся здесь позже.</p>}
    <div class="topic-feed">
      {projects.map(project => <section class="note-preview">
        <h2><a href={`/projects/${project.id}/`}>{project.data.title}</a></h2>
        <p class="note-excerpt">{project.data.description}</p>
        <div class="note-meta"><FormattedDate date={project.data.date} /><a href={`/projects/${project.id}/`}>Подробнее ↗</a></div>
      </section>)}
    </div>
  </Container>
</Layout>
