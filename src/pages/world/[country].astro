---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { getCollection, type CollectionEntry } from "astro:content";
type CityData = CollectionEntry<"countries">;

export async function getStaticPaths() {
    const allCities = (await getCollection("countries")).filter(city => !city.data.draft);
    const uniqueCountries = [
        ...new Set(allCities.map((city) => city.data.country)),
    ];

    return uniqueCountries.map((countryName) => {
        const countryCities = allCities.filter(
            (city) => city.data.country === countryName,
        );
        const flag = countryCities[0]?.data.flag || "🌍";
        const slug = countryName.toLowerCase().replace(/\s+/g, "-");

        return {
            params: { country: slug },
            props: {
                countryName,
                flag,
                cities: countryCities.sort((a, b) =>
                    a.data.title.localeCompare(b.data.title, "ru"),
                ),
            },
        };
    });
}

interface Props {
    countryName: string;
    flag: string;
    cities: CityData[];
}

const { countryName, flag, cities } = Astro.props;

const totalCities = cities.length;
const favorites = cities.filter((c) => c.data.favorite || c.data.rating === 5);
---
<Layout title={`${countryName} ${flag}`} description={`Места, в которых я побывал: ${countryName}.`}>
  <Container>
    <div class="journal-page-heading">
      <a href="/world/" class="back-to-notes">← Мир</a>
      <h1><span class="country-heading-flag" aria-hidden="true">{flag}</span> {countryName}<span class="accent-dot">.</span></h1>
      <p class="journal-page-intro">Города, в которых я побывал.</p>
      <p class="place-stats">Городов: {totalCities}</p>
    </div>
    {favorites.length > 0 && <section class="place-section" aria-labelledby="favorites-heading">
      <div class="section-caption"><h2 id="favorites-heading">Избранные места</h2></div>
      <ul class="place-favorites">{favorites.map(city => <li><a href={`/countries/${city.id}/`}>{city.data.title}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
    </section>}
    <section class="place-section" aria-labelledby="cities-heading">
      <div class="section-caption"><h2 id="cities-heading">Все города</h2></div>
      <ul class="place-city-list">{cities.map(city => <li><a href={`/countries/${city.id}/`}>{city.data.title}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
    </section>
  </Container>
</Layout>
