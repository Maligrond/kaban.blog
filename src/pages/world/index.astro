---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import NotePreview from "@components/NotePreview.astro";
import TravelMap from "@components/TravelMap.astro";
import TravelTimeline from "@components/TravelTimeline.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const cities = (await getCollection("countries")).filter(
  (city) => !city.data.draft,
);
const countries = [...new Set(cities.map((city) => city.data.country))];
const countryHref = (name: string) =>
  `/world/${name.toLowerCase().replace(/\s+/g, "-")}/`;
const countryGroups = countries
  .map((name) => ({
    name,
    cities: cities
      .filter((city) => city.data.country === name)
      .sort((a, b) => a.data.title.localeCompare(b.data.title, "ru")),
  }))
  .sort(
    (a, b) =>
      Number(b.cities.some((city) => city.data.photo)) -
        Number(a.cities.some((city) => city.data.photo)) ||
      a.name.localeCompare(b.name, "ru"),
  );
const favorites = cities
  .filter((city) => city.data.favorite)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "ru"))
  .slice(0, 8);
const stories = (await getCollection("blog"))
  .filter(
    (post) =>
      !post.data.draft &&
      (post.data.cities.length > 0 ||
        post.data.tags?.some((tag) =>
          ["мир", "путешествия", "поездки"].includes(tag.toLowerCase()),
        )),
  )
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Мир" description="Мои поездки, фотографии, города и страны">
  <Container>
    <div class="world-page">
      <div class="journal-page-heading" data-author-collection="countries">
        <h1>
          Мир<span class="accent-dot">.</span>
        </h1>
        <p class="journal-page-intro">
          Места, в которых я побывал, и истории из поездок.
        </p>
      </div>
      <div class="world-summary">
        <span>
          Городов: {cities.length} <span aria-hidden="true">·</span> Стран:{" "}
          {countries.length}
        </span>
        <a href="/about/countries/">Все города с оценками ↗</a>
      </div>
      <TravelMap cities={cities} />
      <div class="world-views" role="group" aria-label="Показать поездки" hidden data-world-views data-pagefind-ignore>
        <button type="button" aria-pressed="true" aria-controls="world-countries" data-world-view="countries">По странам</button>
        <button type="button" aria-pressed="false" aria-controls="world-years" data-world-view="years">По годам</button>
      </div>
      <section id="world-countries" class="country-atlas" aria-label="Города по странам">
        {[
          countryGroups.filter((group) =>
            group.cities.some((city) => city.data.photo),
          ),
          countryGroups.filter(
            (group) => !group.cities.some((city) => city.data.photo),
          ),
        ].map((groups) => (
          <div class="atlas-group">
            {groups.map((group) => (
              <section
                class:list={[
                  "atlas-country",
                  {
                    "atlas-with-photos": group.cities.some(
                      (city) => city.data.photo,
                    ),
                  },
                ]}
              >
                <h2>
                  <a href={countryHref(group.name)}>{group.name}</a>
                </h2>
                <div class="atlas-photos">
                  {group.cities
                    .filter((city) => city.data.photo)
                    .map((city) => (
                      <a
                        class="world-photo-place"
                        href={`/countries/${city.id}/`}
                      >
                        <Image
                          src={city.data.photo!}
                          alt={city.data.photoAlt || city.data.title}
                          widths={[400, 800, 1200]}
                          sizes="(max-width:640px) calc(100vw - 40px), (max-width:900px) 45vw, 340px"
                          loading="lazy"
                        />
                        <h3>{city.data.title}</h3>
                        <div class="world-place-meta">
                          <FormattedDate date={city.data.date} compact />
                        </div>
                      </a>
                    ))}
                </div>
                <ul class="atlas-city-list">
                  {group.cities
                    .filter((city) => !city.data.photo)
                    .map((city) => (
                      <li>
                        <a href={`/countries/${city.id}/`}>{city.data.title}</a>
                      </li>
                    ))}
                </ul>
              </section>
            ))}
          </div>
        ))}
      </section>
      <TravelTimeline cities={cities} />
      {favorites.length > 0 && (
        <aside class="world-favorites">
          <h2>Любимые места</h2>
          <ul>
            {favorites.map((city) => (
              <li>
                <a href={`/countries/${city.id}/`}>{city.data.title}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
      {stories.length > 0 && (
        <section
          class="world-stories"
          aria-labelledby="world-stories-heading"
          data-pagefind-ignore
        >
          <h2 id="world-stories-heading">Рассказы о поездках</h2>
          {stories.map((post) => (
            <NotePreview post={post} />
          ))}
        </section>
      )}
    </div>
  </Container>
</Layout>

<script>
  function setupWorldViews() {
    const controls=document.querySelector<HTMLElement>('[data-world-views]');
    const countries=document.getElementById('world-countries');
    const years=document.getElementById('world-years');
    if(!controls || !countries || !years || controls.dataset.ready)return;
    controls.dataset.ready='true';controls.hidden=false;
    const buttons=controls.querySelectorAll<HTMLButtonElement>('[data-world-view]');
    function show(view:string) {
      countries!.hidden=view==='years';years!.hidden=view!=='years';
      buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.worldView===view)));
    }
    function fromHash(){show(location.hash==='#years'?'years':'countries');}
    buttons.forEach(button=>button.addEventListener('click',()=>{
      const view=button.dataset.worldView!;show(view);
      history.replaceState(history.state,'',location.pathname+location.search+(view==='years'?'#years':''));
    }));
    window.addEventListener('hashchange',fromHash);
    document.addEventListener('astro:before-swap',()=>window.removeEventListener('hashchange',fromHash),{once:true});
    fromHash();
  }
  setupWorldViews();
  document.addEventListener('astro:page-load',setupWorldViews);
</script>

<style>
  .world-views:not([hidden]) { display:flex; gap:20px; margin-top:22px; font:16px/1.4 'PT Sans',sans-serif; }
  .world-views button { cursor:pointer; padding:5px 0; color:var(--journal-muted); border-bottom:1px solid transparent; }
  .world-views button[aria-pressed="true"] { color:var(--journal-ink); border-bottom-color:var(--journal-accent); }
  .world-views button:hover { color:var(--journal-accent); }
  .world-views button:focus-visible { outline:2px solid var(--journal-accent); outline-offset:4px; }
  .world-views ~ .country-atlas { margin-top:20px; }
  .world-page {
    max-width: 1080px;
  }
  .world-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    padding-block: 10px;
    border-block: 1px solid var(--journal-rule);
    color: var(--journal-muted);
    font-size: 14px;
  }
  .world-summary > span > span {
    margin-inline: 8px;
  }
  .world-summary a {
    color: var(--journal-accent);
  }
  .country-atlas {
    margin-top: 26px;
  }
  .atlas-group {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 28px;
    align-items: start;
  }
  .atlas-group + .atlas-group {
    margin-top: 30px;
  }
  .atlas-country h2 {
    font:
      700 30px/1.1 "PT Sans",
      sans-serif;
    letter-spacing: -0.035em;
    margin-bottom: 12px;
  }
  .atlas-photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px;
  }
  .world-photo-place img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3/2;
    object-fit: cover;
  }
  .world-photo-place h3 {
    font:
      700 22px/1.15 "PT Sans",
      sans-serif;
    margin-top: 7px;
    letter-spacing: -0.025em;
  }
  .world-place-meta {
    color: var(--journal-muted);
    font:
      13px/1.4 "PT Sans",
      sans-serif;
    margin-top: 2px;
  }
  .atlas-city-list {
    display: flex;
    flex-wrap: wrap;
    gap: 3px 16px;
    font:
      18px/1.55 "PT Sans",
      sans-serif;
  }
  .atlas-city-list:not(:empty) {
    margin-top: 10px;
  }
  .atlas-city-list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .world-page a:hover {
    color: var(--journal-accent);
  }
  .world-favorites {
    margin-top: 30px;
    border-top: 1px solid var(--journal-rule);
    padding-top: 16px;
  }
  .world-favorites h2,
  .world-stories > h2 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: -0.025em;
  }
  .world-favorites ul {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 22px;
    font-size: 18px;
  }
  .world-stories {
    max-width: 850px;
    margin-top: 28px;
    border-top: 1px solid var(--journal-rule);
    padding-top: 20px;
  }
  @media (min-width: 641px) and (max-width: 900px) {
    .atlas-group {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .atlas-group {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .atlas-country h2 {
      font-size: 28px;
    }
    .atlas-city-list {
      font-size: 17px;
    }
  }
</style>
