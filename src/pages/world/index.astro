---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import NotePreview from "@components/NotePreview.astro";
import TravelMap from "@components/TravelMap.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const cities = (await getCollection("countries")).filter(city => !city.data.draft);
const countries = [...new Set(cities.map(city => city.data.country))];
const countryHref = (name: string) => `/world/${name.toLowerCase().replace(/\s+/g, "-")}/`;
const photoPlaces = cities.filter(city => city.data.photo)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const favorites = cities.filter(city => city.data.favorite)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "ru")).slice(0, 8);

// Country and city names share one alphabet. Identically named places lead
// to the country page, which includes the city's link (e.g. Monaco).
const places = new Map<string, { title: string; href: string; country: boolean }>();
for (const name of countries) places.set(name.toLocaleLowerCase("ru"), { title: name, href: countryHref(name), country: true });
for (const city of cities) {
  const key = city.data.title.toLocaleLowerCase("ru");
  if (!places.has(key)) places.set(key, { title: city.data.title, href: `/countries/${city.id}/`, country: false });
}
const sorted = [...places.values()].sort((a, b) => a.title.localeCompare(b.title, "ru"));
const groups = Object.groupBy(sorted, place => place.title.charAt(0).toUpperCase());
const stories = (await getCollection("blog")).filter(post => !post.data.draft &&
  (post.data.cities.length > 0 || post.data.tags?.some(tag => ["мир", "путешествия", "поездки"].includes(tag.toLowerCase()))))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Мир" description="Мои поездки, фотографии, города и страны">
  <Container>
    <div class="world-page">
      <div class="journal-page-heading">
        <h1>Мир<span class="accent-dot">.</span></h1>
        <p class="journal-page-intro">Места, в которых я побывал, и истории из поездок.</p>
      </div>
      {photoPlaces.length > 0 && <section class="world-photos" aria-labelledby="world-photos-heading">
        <h2 id="world-photos-heading">Из поездок</h2>
        <div class="world-photo-grid">
          {photoPlaces.map((city, index) => <a class:list={["world-photo-place", { "world-photo-lead": index === 0 }]} href={`/countries/${city.id}/`}>
            {city.data.photo && <Image src={city.data.photo} alt={city.data.photoAlt || city.data.title}
              widths={[400, 800, 1200]} sizes={index === 0 ? "(max-width: 640px) calc(100vw - 40px), (max-width: 900px) 50vw, 530px" : "(max-width: 640px) calc(50vw - 28px), 265px"}
              loading={index === 0 ? "eager" : "lazy"} />}
            <h3>{city.data.title}</h3>
            <div class="world-place-meta"><span>{city.data.country}</span>{" "}<FormattedDate date={city.data.date} compact /></div>
          </a>)}
        </div>
      </section>}
      <div class="world-summary">
        <span>Городов: {cities.length} <span aria-hidden="true">·</span> Стран: {countries.length}</span>
        <a href="/about/countries/">Все города с оценками ↗</a>
      </div>
      <TravelMap cities={cities} />
      <div class="world-directory-layout">
        <section class="world-directory" aria-labelledby="world-directory-heading">
          <h2 id="world-directory-heading">Города и страны</h2>
          <dl>
            {Object.entries(groups).map(([letter, entries]) => <div class="world-alphabet-row">
              <dt>{letter}</dt>
              <dd>{entries?.map((place, index) => <>
                {index > 0 && <span class="world-separator" aria-hidden="true"> · </span>}
                <a class:list={{ "world-country": place.country }} href={place.href}>{place.title}</a>
              </>)}</dd>
            </div>)}
          </dl>
        </section>
        {favorites.length > 0 && <aside class="world-favorites" aria-labelledby="world-favorites-heading">
          <h2 id="world-favorites-heading">Любимые места</h2>
          <ul>{favorites.map(city => <li><a href={`/countries/${city.id}/`}>{city.data.title}</a></li>)}</ul>
        </aside>}
      </div>
      {stories.length > 0 && <section class="world-stories" aria-labelledby="world-stories-heading" data-pagefind-ignore>
        <h2 id="world-stories-heading">Рассказы о поездках</h2>
        {stories.map(post => <NotePreview post={post} />)}
      </section>}
    </div>
  </Container>
</Layout>

<style>
  .world-page :is(section, aside) > h2 { font-size: 22px; font-weight: 700; line-height: 1.3; margin-bottom: 12px; letter-spacing: -.02em; }
  .world-photo-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 16px; align-items: start; }
  .world-photo-place { min-width: 0; }
  .world-photo-place img { display: block; width: 100%; height: clamp(180px, 22vw, 250px); object-fit: cover; }
  .world-photo-place h3 { margin: 8px 0 0; font-size: 24px; font-weight: 700; line-height: 1.15; letter-spacing: -.02em; }
  .world-place-meta { display: flex; flex-wrap: wrap; gap: 0 10px; margin-top: 2px; color: var(--journal-muted); font: 14px/1.35 "PT Sans", sans-serif; }
  .world-place-meta time { white-space: nowrap; }
  .world-page a:hover { color: var(--journal-accent); }
  .world-summary { display: flex; flex-wrap: wrap; gap: 6px 22px; padding-block: 12px; margin-top: 16px; border-block: 1px solid var(--journal-rule); font-size: 14px; color: var(--journal-muted); }
  .world-summary > span > span { margin-inline: 8px; }
  .world-summary a { color: var(--journal-accent); }
  .world-directory-layout { display: grid; grid-template-columns: minmax(0, 760px) minmax(160px, 1fr); gap: 40px; margin-top: 20px; }
  .world-alphabet-row { display: grid; grid-template-columns: 20px minmax(0, 1fr); column-gap: 12px; margin-bottom: 6px; }
  .world-alphabet-row dt { padding-top: 5px; font-size: 13px; color: var(--journal-muted); }
  .world-alphabet-row dd { font-size: 18px; line-height: 1.65; }
  .world-alphabet-row a { display: inline-block; max-width: 100%; overflow-wrap: anywhere; }
  .world-country { color: var(--journal-accent); }
  .world-separator { color: var(--journal-muted); }
  .world-directory a:hover, .world-favorites a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .world-favorites ul { font-size: 18px; line-height: 1.8; }
  .world-favorites li + li { margin-top: 3px; }
  .world-stories { max-width: 760px; margin-top: 32px; border-top: 1px solid var(--journal-rule); padding-top: 20px; }
  @media (max-width: 900px) {
    .world-directory-layout { gap: 32px; }
    .world-photo-place:not(.world-photo-lead) .world-place-meta { display: block; }
    .world-photo-place:not(.world-photo-lead) .world-place-meta time { display: block; }
  }
  @media (max-width: 640px) {
    .world-photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .world-photo-place img { height: auto; aspect-ratio: 4 / 3; }
    .world-photo-lead { grid-column: 1 / -1; }
    .world-photo-lead img { aspect-ratio: 16 / 9; }
    .world-photo-place h3 { font-size: 21px; }
    .world-photo-lead h3 { font-size: 25px; }
    .world-alphabet-row dd { line-height: 1.85; }
    .world-directory-layout { grid-template-columns: minmax(0, 1fr); gap: 30px; }
    .world-favorites ul { display: flex; flex-wrap: wrap; gap: 4px 22px; }
    .world-favorites li + li { margin-top: 0; }
  }
</style>
