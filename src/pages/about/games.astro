---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ReviewShelf from "@components/ReviewShelf.astro";
import { getCollection } from "astro:content";
const entries = (await getCollection("games")).filter(entry => !entry.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title, "ru"));
---
<Layout title="Игры" description="Видеоигры, которые меня впечатлили.">
  <Container>
    <div class="journal-page-heading" data-author-collection="games">
      <a href="/about/" class="back-to-notes">← Обо мне</a>
      <h1>Игры<span class="accent-dot">.</span></h1>
      <p class="journal-page-intro shelf-intro">Видеоигры, которые меня впечатлили.</p>
    </div>
    <ReviewShelf entries={entries} collection="games" />
  </Container>
</Layout>
