---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Rating from "@components/Rating.astro";
import { getCollection } from "astro:content";
const cities = (await getCollection("countries")).filter(entry => !entry.data.draft).sort((a, b) => a.data.country.localeCompare(b.data.country, "ru") || a.data.title.localeCompare(b.data.title, "ru"));
const countries = [...new Set(cities.map(city => city.data.country))].sort((a, b) => a.localeCompare(b, "ru"));
---
<Layout title="Города" description="Города, в которых я побывал, и мои оценки">
  <Container>
    <div class="journal-page-heading" data-author-collection="countries">
      <a href="/world/" class="back-to-notes">← Мир</a>
      <h1>Города<span class="accent-dot">.</span></h1>
      <p class="journal-page-intro">Места, в которых я побывал, и мои впечатления.</p>
    </div>
    <form id="city-filters" class="city-filters" hidden>
      <label>Страна<select name="country"><option value="">Все страны</option>{countries.map(country => <option value={country}>{country}</option>)}</select></label>
      <label class="favorite-control"><input type="checkbox" name="favorites" /> Только избранные</label>
    </form>
    <p class="place-stats city-results" aria-live="polite" aria-atomic="true">Городов: {cities.length}</p>
    <ul class="review-shelf city-review-list" id="city-reviews">
      {cities.map(city => <li data-country={city.data.country} data-favorite={String(city.data.favorite || city.data.rating === 5)}>
        <a class="review-shelf-link" href={`/countries/${city.id}/`}>
          <div class="review-shelf-info"><h2><span aria-hidden="true">{city.data.flag}</span> {city.data.title}</h2><p>{city.data.country}</p></div>
          <Rating value={city.data.rating} /><span class="review-arrow" aria-hidden="true">↗</span>
        </a>
      </li>)}
    </ul>
    <p id="city-empty" class="journal-page-intro" hidden>Таких городов пока нет. Попробуй другую страну или отключи фильтр избранного.</p>
  </Container>
</Layout>
<script>
  function updateCities() {
    const form = document.querySelector<HTMLFormElement>("#city-filters");
    if (!form) return;
    form.hidden = false;
    const country = form.querySelector<HTMLSelectElement>('select[name="country"]')?.value || "";
    const favorites = form.querySelector<HTMLInputElement>('input[name="favorites"]')?.checked || false;
    let count = 0;
    document.querySelectorAll<HTMLElement>("#city-reviews > li").forEach(item => {
      item.hidden = (country !== "" && item.dataset.country !== country) || (favorites && item.dataset.favorite !== "true");
      if (!item.hidden) count++;
    });
    const results = document.querySelector(".city-results");
    if (results) results.textContent = `Городов: ${count}`;
    const empty = document.getElementById("city-empty");
    if (empty) empty.hidden = count !== 0;
  }
  document.addEventListener("change", event => {
    if (event.target instanceof Element && event.target.closest("#city-filters")) updateCities();
  });
  document.addEventListener("astro:page-load", updateCities);
  updateCities();
</script>
