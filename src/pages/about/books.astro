---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ReviewShelf from "@components/ReviewShelf.astro";
import { getCollection } from "astro:content";
const entries = (await getCollection("books")).filter(entry => !entry.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title, "ru"));
---
<Layout title="Книги" description="Здесь я делюсь книгами, которые прочитал и считаю достойными внимания.">
  <Container>
    <div class="journal-page-heading">
      <a href="/about/" class="back-to-notes">← Обо мне</a>
      <h1>Книги<span class="accent-dot">.</span></h1>
      <p class="journal-page-intro shelf-intro">Здесь я делюсь книгами, которые прочитал и считаю достойными внимания.</p>
    </div>
    <ReviewShelf entries={entries} collection="books" />
  </Container>
</Layout>
