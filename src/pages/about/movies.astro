---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ReviewShelf from "@components/ReviewShelf.astro";
import { getCollection } from "astro:content";
const entries = (await getCollection("movies")).filter(entry => !entry.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title, "ru"));
---
<Layout title="Фильмы" description="Фильмы, которые меня впечатлили.">
  <Container>
    <div class="journal-page-heading">
      <a href="/about/" class="back-to-notes">← Обо мне</a>
      <h1>Фильмы<span class="accent-dot">.</span></h1>
      <p class="journal-page-intro shelf-intro">Фильмы, которые меня впечатлили.</p>
    </div>
    <ReviewShelf entries={entries} collection="movies" />
  </Container>
</Layout>
