---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { blogArchive } from "../../lib/blog-archive.js";

interface Props { years: ReturnType<typeof blogArchive>; }

export async function getStaticPaths() {
  const years = blogArchive(await getCollection("blog"));
  return [
    { params: { period: undefined }, props: { years } },
    ...years.flatMap(group => [
      { params: { period: group.year }, props: { years } },
      ...group.months.map(month => ({ params: { period: `${group.year}/${month.month}` }, props: { years } })),
    ]),
  ];
}
const { years } = Astro.props;
const [year, month] = (Astro.params.period || "").split("/");
const selectedYear = years.find(group => group.year === year);
const selectedMonth = selectedYear?.months.find(group => group.month === month);
const title = selectedMonth ? `${selectedMonth.label} ${year}` : year ? `Архив за ${year} год` : "Архив";
const groups = selectedYear ? [selectedYear] : years;
const count = selectedMonth?.posts.length ?? groups.reduce((total, group) => total + group.posts.length, 0);
const shortDate = new Intl.DateTimeFormat("ru-RU", { day: "numeric", month: "short", timeZone: "UTC" });
---
<Layout title={title} description="Все записи блога по годам и месяцам.">
  <Container>
    <div class="journal-page archive-page" data-pagefind-ignore="all">
      <a class="back-to-notes" href="/blog/">← Блог</a>
      <div class="journal-page-heading">
        <h1>{selectedMonth ? <>{selectedMonth.label} <span class="archive-title-year">{year}</span></> : year || "Архив"}<span class="accent-dot">.</span></h1>
        <p class="archive-count">Записей: {count}</p>
      </div>
      <nav class="archive-periods" aria-label="Годы архива">
        <a href="/archive/" aria-current={!year ? "page" : undefined}>Все годы</a>
        {years.map(group => <a href={`/archive/${group.year}/`} aria-current={year === group.year ? (month ? "true" : "page") : undefined}>{group.year}<span>{group.posts.length}</span></a>)}
      </nav>
      {selectedYear && <nav class="archive-periods archive-months" aria-label={`Месяцы ${year} года`}>
        <a href={`/archive/${year}/`} aria-current={!month ? "page" : undefined}>Весь год</a>
        {selectedYear.months.map(group => <a href={`/archive/${year}/${group.month}/`} aria-current={month === group.month ? "page" : undefined}>{group.label}<span>{group.posts.length}</span></a>)}
      </nav>}
      {groups.map(group => <section class="archive-list-section" aria-label={`Записи за ${group.year} год`}>
        {!year && <h2><a href={`/archive/${group.year}/`}>{group.year}</a></h2>}
        <ul class="archive-entries">
          {(selectedMonth?.posts || group.posts).map((post: CollectionEntry<"blog">) => <li>
            <time datetime={post.data.date.toISOString()}>{shortDate.format(post.data.date)}</time>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </li>)}
        </ul>
      </section>)}
      {!years.length && <p class="journal-page-intro">Здесь появятся опубликованные записи.</p>}
    </div>
  </Container>
</Layout>

<style>
  .archive-page { max-width: 740px; }
  .back-to-notes { display: inline-block; margin-bottom: 12px; font-size: 15px; }
  .archive-title-year { color: var(--journal-muted); }
  .archive-count { margin-top: 8px; color: var(--journal-muted); font-size: 15px; }
  .archive-periods { display: flex; flex-wrap: wrap; gap: 4px 22px; padding-bottom: 12px; border-bottom: 1px solid var(--journal-rule); }
  .archive-periods a { display: inline-flex; gap: 6px; align-items: baseline; padding-block: 8px; color: var(--journal-muted); font-size: 17px; }
  .archive-periods a[aria-current], .archive-periods a:hover { color: var(--journal-accent); }
  .archive-periods a[aria-current="page"] { text-decoration: underline; text-underline-offset: 5px; }
  .archive-periods span { font-size: 12px; color: var(--journal-muted); }
  .archive-months { padding-top: 6px; }
  .archive-months a { font-size: 15px; }
  .archive-list-section { margin-top: 22px; }
  .archive-list-section h2 { margin-bottom: 8px; font-size: 22px; font-weight: 700; }
  .archive-entries { list-style: none; margin: 0; padding: 0; }
  .archive-entries li { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 16px; align-items: baseline; padding-block: 8px; }
  .archive-entries time { font-size: 14px; color: var(--journal-muted); white-space: nowrap; }
  .archive-entries a { font-size: 20px; line-height: 1.35; text-decoration: underline; text-decoration-color: var(--journal-rule); text-underline-offset: 4px; overflow-wrap: anywhere; }
  .archive-entries a:hover { color: var(--journal-accent); text-decoration-color: currentColor; }
  @media (max-width: 540px) {
    .archive-periods { column-gap: 18px; }
    .archive-entries li { grid-template-columns: 62px minmax(0, 1fr); gap: 12px; }
    .archive-entries a { font-size: 18px; }
  }
</style>
