---
import type { CollectionEntry } from "astro:content";
import { postSummary } from "../lib/post-text.js";
import FormattedDate from "./FormattedDate.astro";
interface Props { post: CollectionEntry<"blog">; }
const { post } = Astro.props;
const preview = postSummary(post.data.excerpt || post.body || "", 360) || post.data.description;
---
<section class="note-preview">
  <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
  <p class="note-excerpt">{preview}</p>
  <div class="note-meta">
    <FormattedDate date={post.data.date} />
    {(post.data.tags || []).map(tag => <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
    <a class="read-note" href={`/blog/${post.id}/`}>Читать дальше <span aria-hidden="true">↗</span></a>
  </div>
</section>
