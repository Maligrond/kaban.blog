---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { postSummary } from '../lib/post-text.js';
import { resolveCityCoordinates } from '../lib/city-geocoding.js';
interface Props { cities: CollectionEntry<'countries'>[] }
const { cities } = Astro.props;
const locatedCities = await resolveCityCoordinates(cities);
const places = await Promise.all(locatedCities.sort((a,b) => a.data.title.localeCompare(b.data.title,'ru')).map(async city => ({
  id: city.id, title: city.data.title, country: city.data.country,
  coordinates: city.data.coordinates!, rating: city.data.rating,
  summary: postSummary(city.body, 150), href: `/countries/${city.id}/`,
  photo: city.data.photo ? (await getImage({src: city.data.photo, width: 440, format: 'webp'})).src : null,
  photoAlt: city.data.photoAlt || city.data.title,
})));
---
{places.length > 0 && <details class="travel-map" data-travel-map data-pagefind-ignore>
  <summary><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z"/><path d="M9 3v15M15 6v15"/></svg><span>Карта поездок</span><span class="travel-map-chevron" aria-hidden="true">⌄</span></summary>
  <div class="travel-map-body">
    <div class="travel-map-tools">
      <div class="travel-map-regions" aria-label="Область карты">
        <button type="button" data-region="world">Весь мир</button>
        <button type="button" data-region="europe">Европа</button>
        <button type="button" data-region="america">Америка</button>
        <button type="button" data-region="japan">Япония</button>
      </div>
      <select aria-label="Выбрать город на карте" data-map-city>
        <option value="">Выбрать город</option>
        {places.map(place => <option value={place.id}>{place.title}</option>)}
      </select>
    </div>
    <div class="travel-map-canvas" data-map-canvas role="region" aria-label="Карта посещённых городов"></div>
    <p class="travel-map-hint" data-map-status role="status">Нажми на точку, чтобы посмотреть город.</p>
  </div>
  <script type="application/json" data-map-places set:html={JSON.stringify(places).replace(/</g,'\\u003c')} />
</details>}
<script>
  import { setupTravelMap } from '../scripts/travel-map';
  setupTravelMap();
  document.addEventListener('astro:page-load', setupTravelMap);
</script>
<style is:global>
  .travel-map { margin-top: 12px; }
  .travel-map > summary { display:flex; align-items:center; gap:8px; width:fit-content; cursor:pointer; color:var(--journal-accent); font-size:16px; list-style:none; }
  .travel-map > summary::-webkit-details-marker { display:none; }
  .travel-map > summary:hover span:first-of-type { text-decoration:underline; text-underline-offset:3px; }
  .travel-map-chevron { transition:transform .15s; color:var(--journal-muted); }
  .travel-map[open] .travel-map-chevron { transform:rotate(180deg); }
  .travel-map-tools { display:flex; justify-content:space-between; gap:12px; align-items:center; flex-wrap:wrap; margin:12px 0 10px; font-size:14px; }
  .travel-map-regions { display:flex; gap:14px; flex-wrap:wrap; }
  .travel-map-regions button { cursor:pointer; color:var(--journal-muted); border-bottom:1px solid transparent; }
  .travel-map-regions button[aria-pressed="true"] { color:var(--journal-accent); border-bottom-color:currentColor; }
  .travel-map-tools select { color:var(--journal-muted); background:var(--journal-paper); border:1px solid var(--journal-rule); padding:4px 8px; border-radius:3px; max-width:100%; }
  .travel-map-canvas { height:440px; width:100%; isolation:isolate; background:var(--journal-rule); border:1px solid var(--journal-rule); z-index:0; }
  .travel-map-hint { margin-top:7px; color:var(--journal-muted); font:13px/1.4 'PT Sans',sans-serif; }
  .travel-map-canvas .leaflet-tile-pane { filter:grayscale(.95) sepia(.12); }
  html.dark .travel-map-canvas .leaflet-tile-pane { filter:grayscale(1) invert(1) brightness(.85); }
  .travel-map-canvas .leaflet-control-attribution { background:var(--journal-paper); color:var(--journal-muted); font-size:10px; }
  .travel-map-canvas .leaflet-control-attribution a { color:var(--journal-accent); }
  .travel-map-canvas .leaflet-bar a { background:var(--journal-paper); color:var(--journal-ink); border-color:var(--journal-rule); }
  .travel-map-canvas .leaflet-bar a:hover { background:var(--journal-rule); }
  .travel-map-canvas .leaflet-popup-content-wrapper, .travel-map-canvas .leaflet-popup-tip { background:var(--journal-paper); color:var(--journal-ink); border-radius:3px; }
  .travel-map-canvas .leaflet-popup-content { margin:14px; width:220px !important; font:15px/1.4 'PT Sans',sans-serif; }
  .travel-map-canvas .leaflet-popup-close-button { color:var(--journal-muted); }
  .travel-map-point { background:none; border:0; display:grid; place-items:center; }
  .travel-map-point::after { content:''; width:9px; height:9px; background:var(--journal-accent); border:2px solid var(--journal-paper); border-radius:50%; box-shadow:0 0 0 1px var(--journal-accent); }
  .travel-map-point:hover::after, .travel-map-point:focus-visible::after, .travel-map-point.is-selected::after { width:14px; height:14px; }
  .travel-map-canvas :focus-visible, .travel-map :is(summary,button,select):focus-visible { outline:2px solid var(--journal-accent); outline-offset:3px; }
  .travel-map-card img { display:block; width:100%; height:130px; object-fit:cover; margin-bottom:9px; }
  .travel-map-card h3 { font-size:22px; line-height:1.15; font-weight:700; margin:0; }
  .travel-map-card .travel-map-meta { margin:3px 0 8px; color:var(--journal-muted); font-size:13px; }
  .travel-map-card p { margin:8px 0; }
  .travel-map-card a { color:var(--journal-accent); text-decoration:underline; text-underline-offset:3px; }
  @media(max-width:640px) { .travel-map-canvas { height:380px; } .travel-map-tools { align-items:flex-start; } .travel-map-tools select { width:100%; } .travel-map-regions button { min-height:32px; } }
  @media(prefers-reduced-motion:reduce) { .travel-map-chevron { transition:none; } }
</style>
