---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { groupTripsByYear } from '../lib/travel-timeline.js';
interface Props { cities: CollectionEntry<'countries'>[] }
const { cities } = Astro.props;
const groups = groupTripsByYear(cities);
---
<section id="world-years" class="travel-timeline" aria-label="Города по годам поездок" hidden data-pagefind-ignore>
  {groups.map(group => <section class="travel-year" aria-labelledby={`travel-year-${group.year}`}>
    <h2 id={`travel-year-${group.year}`} class:list={{'travel-undated':group.year===null}}>{group.year ?? 'Без года'}</h2>
    <div class="travel-year-places">
      {group.year===null && <p class="travel-year-hint">Год поездки пока не указан.</p>}
      {group.cities.some(city => city.data.photo) && <ul class="travel-year-photos">
        {group.cities.filter(city => city.data.photo).map(city => <li>
          <a href={`/countries/${city.id}/`}>
            <Image src={city.data.photo!} alt={city.data.photoAlt || city.data.title}
              widths={[400,800,1200]} sizes="(max-width:640px) calc(100vw - 40px), (max-width:900px) 45vw, 300px" loading="lazy" />
            <span class="travel-city-name">{city.data.title}</span>
            <span class="travel-city-country">{city.data.country}</span>
          </a>
        </li>)}
      </ul>}
      {group.cities.some(city => !city.data.photo) && <ul class="travel-year-cities">
        {group.cities.filter(city => !city.data.photo).map(city => <li>
          <a href={`/countries/${city.id}/`}>{city.data.title}</a>
          <span class="travel-city-country">{city.data.country}</span>
        </li>)}
      </ul>}
    </div>
  </section>)}
</section>

<style>
  .travel-timeline { margin-top:26px; }
  .travel-year { display:grid; grid-template-columns:80px minmax(0,1fr); gap:20px; }
  .travel-year + .travel-year { margin-top:28px; }
  .travel-year h2 { font:700 30px/1.1 'PT Sans',sans-serif; letter-spacing:-.035em; }
  .travel-year h2.travel-undated { font-size:22px; }
  .travel-year-hint { color:var(--journal-muted); font:14px/1.5 'PT Sans',sans-serif; margin-bottom:14px; }
  .travel-year-places { min-width:0; padding-left:22px; border-left:1px solid var(--journal-rule); }
  .travel-year-photos { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
  .travel-year-photos img { display:block; width:100%; height:auto; aspect-ratio:3/2; object-fit:cover; margin-bottom:7px; }
  .travel-city-name { display:block; font:700 22px/1.15 'PT Sans',sans-serif; letter-spacing:-.025em; }
  .travel-city-country { display:block; color:var(--journal-muted); font:13px/1.5 'PT Sans',sans-serif; margin-top:2px; }
  .travel-year-cities { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px 24px; font:18px/1.3 'PT Sans',sans-serif; }
  .travel-year-photos + .travel-year-cities { margin-top:20px; }
  a:hover { color:var(--journal-accent); }
  .travel-year-cities a:hover { text-decoration:underline; text-underline-offset:3px; }
  @media(max-width:900px) {
    .travel-year-photos, .travel-year-cities { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media(max-width:640px) {
    .travel-year { grid-template-columns:minmax(0,1fr); gap:14px; }
    .travel-year h2 { font-size:28px; }
    .travel-year-places { padding-left:0; border-left:0; }
    .travel-year-photos { grid-template-columns:minmax(0,1fr); }
    .travel-year-cities { gap:12px 16px; font-size:17px; }
  }
</style>
