---
import Container from "@components/Container.astro";
const path = Astro.url.pathname;
const section = path.startsWith("/world/") || path.startsWith("/countries/") || path.startsWith("/about/countries") ? "/world/"
  : path.startsWith("/blog/") || path.startsWith("/tags/") ? "/blog/"
  : ["/now/", "/about", "/books/", "/games/", "/movies/", "/bookmarks", "/projects"].some(prefix => path.startsWith(prefix)) ? "/about/" : "";
const links = [{ href: "/blog/", label: "Блог" }, { href: "/world/", label: "Мир" }, { href: "/about/", label: "Обо мне" }];
---
<header class="site-header">
  <Container>
    <div class="site-nav">
      <a href="/" class="site-name" aria-label="Кабан — главная"><img src="/android-chrome-192x192.png" alt="" width="28" height="28" />Кабан<span class="accent-dot">.</span></a>
      <nav aria-label="Основная навигация">
        {links.map(link => <a href={link.href} aria-current={section === link.href ? (path === link.href ? "page" : "location") : undefined}>{link.label}</a>)}
      </nav>
      <button id="magnifying-glass" class="search-trigger" aria-label="Поиск по сайту">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
        <span>Поиск</span>
      </button>
    </div>
  </Container>
</header>
