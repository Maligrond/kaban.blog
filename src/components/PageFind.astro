---
import "@pagefind/default-ui/css/ui.css";
---

<dialog id="search-dialog" transition:persist aria-label="Поиск по сайту"
  class="search-dialog"
  data-pagefind-ignore>
  <div class="search-toolbar">
    <h2 id="search-heading">Поиск</h2>
    <button type="button" id="close-search" class="search-close" aria-label="Закрыть поиск">
      <span class="search-escape" aria-hidden="true">Esc</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
  </div>
  <div id="search" class="pagefind-ui"></div>
  <p class="search-hint">Найди запись, город или что-нибудь интересное.</p>
</dialog>

<script>
  import { escapeHTML } from "../lib/post-text.js";
  import { PagefindUI } from "@pagefind/default-ui";
  function initializeSearch() {
    const search = document.querySelector("#search");
    if (!search || search.querySelector("input")) return;
    new PagefindUI({ element: "#search", showImages: false, showSubResults: false, excerptLength: 20,
      processResult: (result) => {
        const { description, ...meta } = result.meta;
        return { ...result, meta, excerpt: description ? escapeHTML(description) : result.excerpt };
      }, resetStyles: false, translations: {
      search_label: "Поиск по сайту", placeholder: "Что найти?", clear_search: "Очистить", searching: "Ищем…",
      zero_results: "По запросу «[SEARCH_TERM]» ничего не найдено",
      one_result: "Найдено: [COUNT] по запросу «[SEARCH_TERM]»",
      many_results: "Найдено: [COUNT] по запросу «[SEARCH_TERM]»", load_more: "Показать ещё",
    } });
  }
  initializeSearch();
  document.addEventListener("astro:page-load", initializeSearch);
  let previousFocus: HTMLElement | null = null;
  const getDialog = () => document.querySelector<HTMLDialogElement>("#search-dialog");

  function openSearch() {
    const dialog = getDialog();
    if (!dialog || dialog.open) return;
    previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    dialog.showModal();
    dialog.querySelector<HTMLInputElement>("input")?.focus();
  }

  function closeSearch() {
    getDialog()?.close();
  }

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest("#magnifying-glass")) openSearch();
    if (event.target.closest("#close-search, .pagefind-ui__result-link")) closeSearch();
    const dialog = getDialog();
    if (event.target === dialog && dialog) {
      const box = dialog.getBoundingClientRect();
      if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) closeSearch();
    }
  });

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    const editing = target instanceof HTMLElement && (target.isContentEditable || !!target.closest("input, textarea, select, [contenteditable='true']"));
    if ((event.key === "/" && !editing && !event.ctrlKey && !event.metaKey && !event.altKey) || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k")) {
      event.preventDefault();
      openSearch();
    }
  });

  // Capture also handles the dialog preserved across Astro page transitions.
  document.addEventListener("close", (event) => {
    if (event.target !== getDialog()) return;
    const input = getDialog()?.querySelector<HTMLInputElement>("input");
    if (input) {
      input.value = "";
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }
    if (previousFocus?.isConnected) previousFocus.focus();
    previousFocus = null;
  }, true);
  document.addEventListener("astro:before-swap", closeSearch);
</script>

<style>
  .search-dialog {
    width: min(calc(100% - 32px), 640px);
    max-height: 78dvh;
    margin: min(12dvh, 96px) auto auto;
    padding: 20px 24px 24px;
    border: 1px solid var(--journal-rule);
    border-radius: 8px;
    background: var(--journal-paper);
    color: var(--journal-ink);
    box-shadow: 0 20px 80px rgb(0 0 0 / .18);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .search-dialog::backdrop { background: rgb(0 0 0 / .32); backdrop-filter: blur(3px); }
  .search-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .search-toolbar h2 { margin: 0; font: 700 24px/1.2 "PT Sans", sans-serif; letter-spacing: -.02em; }
  .search-close { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 44px; min-height: 44px; color: var(--journal-muted); }
  .search-escape { font: 12px/1 "PT Sans", sans-serif; border: 1px solid var(--journal-rule); border-radius: 3px; padding: 4px 5px; }
  .search-close:hover { color: var(--journal-accent); }
  .search-hint { margin: 16px 0 0; color: var(--journal-muted); font: 15px/1.5 "PT Sans", sans-serif; }
  .search-dialog:has(input:not(:placeholder-shown)) .search-hint { display: none; }
  @media (max-width: 640px) {
    .search-dialog { padding: 12px 16px 20px; margin-top: 24px; max-height: calc(100dvh - 48px); }
    .search-toolbar h2 { font-size: 22px; }
    .search-escape { display: none; }
  }
</style>

<style is:global>
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 5px;
    --pagefind-ui-font: "PT Sans", sans-serif;
    --pagefind-ui-primary: var(--journal-accent);
    --pagefind-ui-text: var(--journal-ink);
    --pagefind-ui-background: var(--journal-paper);
    --pagefind-ui-border: var(--journal-rule);
    --pagefind-ui-tag: var(--journal-paper);
  }
  html:has(#search-dialog[open]) { overflow: hidden; }
  #search input, #search p { font-weight: normal; }
  #search .pagefind-ui__search-input {
    height: 54px; padding: 0 82px 0 44px; font-size: 18px;
    background: color-mix(in srgb, var(--journal-ink) 3%, var(--journal-paper));
  }
  #search .pagefind-ui__search-input::placeholder { color: var(--journal-muted); opacity: 1; }
  #search input:focus-visible { outline: 2px solid color-mix(in srgb, var(--journal-accent) 65%, transparent); outline-offset: 2px; }
  #search .pagefind-ui__form::before { width: 17px; height: 17px; top: 18px; left: 16px; }
  #search .pagefind-ui__search-clear { top: 5px; right: 5px; height: 44px; padding: 0 8px; font-size: 13px; color: var(--journal-muted); background: transparent; }
  #search .pagefind-ui__search-clear:hover { color: var(--journal-accent); }
  #search .pagefind-ui__results-area { margin-top: 8px; }
  #search .pagefind-ui__message { height: auto; min-height: 20px; padding: 12px 0; margin: 0; color: var(--journal-muted); font-size: 14px; line-height: 1.4; }
  #search .pagefind-ui__result { padding-block: 16px; }
  #search .pagefind-ui__result-inner { margin-top: 0; min-width: 0; }
  #search .pagefind-ui__result-title { font-size: 20px; font-weight: 700; line-height: 1.3; }
  #search .pagefind-ui__result-link { text-decoration: none; }
  #search .pagefind-ui__result-link:hover { color: var(--journal-accent); text-decoration: underline; text-underline-offset: 3px; }
  #search .pagefind-ui__result-excerpt { min-width: 0; margin-top: 6px; font: 16px/1.5 Georgia, serif; overflow-wrap: anywhere; }
  #search .pagefind-ui__button { margin-top: 16px; font-size: 15px; font-weight: normal; }
  #search mark { background: color-mix(in srgb, var(--journal-accent), transparent 87%); color: inherit; }
</style>

<style is:global>
  #search .pagefind-ui__result-tags { margin-top: 7px; gap: 8px; }
  #search .pagefind-ui__result-tag { padding: 0; color: var(--journal-muted); font-size: 13px; background: transparent; }
</style>
