---
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute -top-12 right-0">
        <BackToTop />
      </div>
    </div>
    <nav class="footer-links" aria-label="Полезные ссылки">
      <a href="/rss.xml">RSS</a><a href="/archive/">Архив</a><button type="button" data-open-search>Поиск</button>
      {SOCIALS.map(social=><a href={social.HREF} target="_blank" rel="noopener noreferrer">{social.NAME} ↗</a>)}
      {SITE.EMAIL && <a href={`mailto:${SITE.EMAIL}`}>Написать</a>}
    </nav>
    <div class="footer-content">
      <div class="footer-signature">
        <span>&copy; {new Date().getFullYear()} • {SITE.TITLE}</span>
        <a class="footer-author-link" href="/author/" data-astro-reload aria-label="Вход автора через GitHub" title="Вход автора">🐗</a>
      </div>
      <div class="theme-controls" role="group" aria-label="Тема оформления">
        <button
          id="light-theme-button"
          aria-label="Светлая тема" title="Светлая тема"
          class="group flex size-9 items-center justify-center rounded border border-black/15 hover:bg-black/5 focus-visible:bg-black/5 dark:border-white/20 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-colors duration-300 ease-in-out group-hover:animate-pulse group-hover:stroke-black group-focus-visible:animate-pulse group-focus-visible:stroke-black group-hover:dark:stroke-white dark:group-focus-visible:stroke-white"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>
        <button
          id="dark-theme-button"
          aria-label="Тёмная тема" title="Тёмная тема"
          class="group flex size-9 items-center justify-center rounded border border-black/15 hover:bg-black/5 focus-visible:bg-black/5 dark:border-white/20 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-colors duration-300 ease-in-out group-hover:animate-pulse group-hover:stroke-black group-focus-visible:animate-pulse group-focus-visible:stroke-black group-hover:dark:stroke-white dark:group-focus-visible:stroke-white"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <button
          id="system-theme-button"
          aria-label="Системная тема" title="Системная тема"
          class="group flex size-9 items-center justify-center rounded border border-black/15 hover:bg-black/5 focus-visible:bg-black/5 dark:border-white/20 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-colors duration-300 ease-in-out group-hover:animate-pulse group-hover:stroke-black group-focus-visible:animate-pulse group-focus-visible:stroke-black group-hover:dark:stroke-white dark:group-focus-visible:stroke-white"
          >
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</footer>

<style>
  .footer-links { display:flex; flex-wrap:wrap; gap:8px 22px; margin-bottom:14px; font:15px/1.5 "PT Sans",sans-serif; color:var(--journal-muted); }
  .footer-links :is(a,button):hover {color:var(--journal-accent);}
  .footer-links button {cursor:pointer;}
  .footer-links :is(a,button) {padding-block:4px;}
  .footer-signature { display: flex; align-items: center; gap: 6px; }
  .footer-author-link { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; min-height: 44px; text-decoration: none; opacity: .65; }
  .footer-author-link:hover, .footer-author-link:focus-visible { opacity: 1; }
  .footer-author-link:focus-visible { outline: 2px solid var(--journal-accent); outline-offset: 2px; border-radius: 3px; }
</style>
