<script>
  // Readers never load the editor or receive author controls.
  async function restoreAuthorMode() {
    try {if (!sessionStorage.getItem('kaban-author-session'))return;} catch {return;}
    const { activateAuthor } = await import('../scripts/author-editor.js');
    await activateAuthor();
  }
  document.addEventListener('astro:page-load', restoreAuthorMode);
  restoreAuthorMode();
</script>
